<?xml version="1.0" ?>
<sdf version="1.7">

<model name="camera_stand">

  <static>true</static>

  <!-- Stand -->
  <link name="stand_link">

    <!-- VISUAL -->
    <visual name="stand_visual">
      <geometry>
        <box>
          <size>0.1 0.1 1.0</size>
        </box>
      </geometry>

      <material>
        <ambient>0.3 0.3 0.3 1</ambient>
        <diffuse>0.5 0.5 0.5 1</diffuse>
      </material>
    </visual>

    <!-- COLLISION -->
    <collision name="stand_collision">
      <geometry>
        <box>
          <size>0.1 0.1 1.0</size>
        </box>
      </geometry>
    </collision>

  </link>

  <!-- Camera -->
  <link name="camera_link">

    <pose>0 0 1.1 0 0 0</pose>

    <!-- Camera Body -->
    <visual name="camera_visual">
      <geometry>
        <box>
          <size>0.2 0.2 0.1</size>
        </box>
      </geometry>

      <material>
        <ambient>0 0 0 1</ambient>
        <diffuse>0 0 0 1</diffuse>
      </material>
    </visual>

    <!-- CAMERA SENSOR -->
    <sensor name="camera_sensor" type="camera">

      <camera>

        <horizontal_fov>1.5707</horizontal_fov>

        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>

        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>

      </camera>

      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>false</visualize>

      <!-- ROS2 CAMERA PLUGIN -->
      <plugin name="camera_controller"
              filename="libgazebo_ros_camera.so">

        <ros>
          <namespace>/camera</namespace>
        </ros>

        <camera_name>vision_camera</camera_name>

        <image_topic_name>image_raw</image_topic_name>

        <camera_info_topic_name>
          camera_info
        </camera_info_topic_name>

        <frame_name>camera_link</frame_name>

      </plugin>

    </sensor>

  </link>

</model>

</sdf>
